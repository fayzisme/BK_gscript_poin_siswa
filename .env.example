# ════════════════════════════════════════════════════════════════
#  BK POIN & SP · Environment Configuration (.env)
#  TEMPLATE — COPY ini menjadi .env dan sesuaikan nilai.
#  ⚠️ JANGAN COMMIT file .env dengan secret nyata di Git!
# ════════════════════════════════════════════════════════════════

# ── Aplikasi ──
APP_NAME="BK Poin & SP — Nama Sekolah Anda"
APP_ENV=production        # local | production
APP_URL=https://domen-dominio.example.com
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# ── Database (Driver: sqlite | mysql) ──
# Untuk lokal development: sqlite
# Untuk shared hosting RumahWeb cPanel: mysql
DB_DRIVER=mysql

# SQLite (lokal hanya)
SQLITE_PATH=database/database.sqlite

# MySQL/MariaDB (production RumahWeb)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bk_sekolah_db
DB_USER=username_bkuser
DB_PASS=PasswordKuat123!

# ── Keamanan / Sesi ──
# Genera string acak masuk: openssl rand -hex 32
APP_KEY=CHANGE-ME-GENERATE-RANDOM-32BYTES-HEX
SESSION_SECRET=CHANGE-ME-RANDOM-32BYTES-HEX
SESSION_LIFETIME=7200     # sekondo (2 saat)
SESSION_COOKIE_SECURE=true   # menjadi true bila HTTPS production
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=true

# ── Rate Limiting Login ──
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Logging ──
LOG_LEVEL=info            # debug | info | warning | error
LOG_DIR=storage/logs

# ── Ekspor CSV ──
EXPORT_CSV_FILENAME=Ketertiban-Siswa