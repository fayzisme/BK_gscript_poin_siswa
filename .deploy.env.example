# ═══════════════════════════════════════════════════════════════════════
#  TEMPLATE KONFIGURASI DEPLOY — BK POIN & SP
#
#  Cara pakai: copy file ini jadi `.deploy.env` di root repo, lalu isi.
#      cp .deploy.env.example .deploy.env && nano .deploy.env
#
#  ⚠️  .deploy.env SUDAH di-gitignore — aman, tidak akan ter-commit.
# ═══════════════════════════════════════════════════════════════════════
# Host VPS: IP address atau domain (contoh: 103.123.45.67 atau bk.sekolahanda.sch.id)
VPS_HOST=

# User SSH untuk deploy (non-root lebih aman; contoh: deployer)
VPS_USER=deployer

# Path absolut folder aplikasi di server
DEPLOY_PATH=/var/www/bk-poin-sp

# Port SSH (default 22, ubah kalau VPS Anda pakai port custom)
SSH_PORT=22

# Path ke private key SSH di Mac/komputer Anda (contoh: ~/.ssh/bk_deploy_key)
SSH_KEY=~/.ssh/bk_deploy_key
